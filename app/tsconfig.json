{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "types": ["node"],
    "paths": {
      "@core": ["../core/src/index.ts"]
    }
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "../core/src/**/*.ts"],
  "exclude": ["node_modules", "out"]
}
