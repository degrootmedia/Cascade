{
  "name": "cascade-app",
  "version": "0.6.5",
  "description": "Cascade — desktop AI agent powered by the Gab.ai API",
  "main": "out/main/index.js",
  "author": "Chuck",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "package": "electron-vite build && electron-builder --win nsis"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.10.0",
    "@xyflow/react": "^12.11.5",
    "dompurify": "^3.1.0",
    "mammoth": "^1.12.1",
    "marked": "^14.1.0",
    "pdf-parse": "^2.4.5"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.1.2",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^33.0.0",
    "electron-builder": "^25.1.0",
    "electron-vite": "^2.3.0",
    "jsdom": "^30.0.1",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0"
  },
  "build": {
    "appId": "ai.cascade.app",
    "productName": "Cascade",
    "files": [
      "out/**/*"
    ],
    "directories": {
      "output": "release-0.6.5"
    },
    "win": {
      "signAndEditExecutable": false,
      "icon": "build/icon.png"
    },
    "nsis": {
      "include": "build/installer.nsh",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "extraResources": [
      {
        "from": "build/icon.png",
        "to": "icon.png"
      },
      {
        "from": "skills/magic-prompt.md",
        "to": "skills/magic-prompt.md"
      },
      {
        "from": "src/main/magic-prompt.md",
        "to": "magic-prompt.md"
      }
    ]
  }
}
